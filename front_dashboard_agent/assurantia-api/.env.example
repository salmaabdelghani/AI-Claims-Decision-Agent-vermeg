POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sinistres
POSTGRES_USER=user
POSTGRES_PASSWORD=changeme

# URL(s) autorisee(s) a appeler l'API (le frontend Vite tourne par defaut sur 5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Chemin vers le projet mailconnector et interpreteur Python a utiliser pour
# le LANCER depuis le dashboard (bouton "Lancer le processus" / lancement
# automatique au premier "Demarrer l'agent") — evite d'avoir a l'ouvrir
# manuellement via VSCode. MAILCONNECTOR_PYTHON doit pointer vers le python
# du venv ou sont installes les dependances de mailconnector (requirements.txt).
MAILCONNECTOR_DIR=../../mailconnector/mailconnector
MAILCONNECTOR_PYTHON=python

# Dossier local ou l'agent mailconnector ecrit ses rapports PDF d'analyse
# (voir mailconnector/mailconnector/agent/pdf_report_generator.py). Utilise
# en repli par /api/agent/sinistres/{id}/rapport.pdf si le chemin enregistre
# en base (colonne sinistres.pdf_path) n'est plus valide a cet endroit
# (ex: API et agent ne tournent pas depuis le meme chemin absolu).
RAPPORT_ANALYSE_DIR=../../mailconnector/mailconnector/rapport_analyse
